MERM_DEPLOY_ENV=staging
MERM_SIGNAL_WS_URL=wss://p2p-signal-staging.fly.dev
MERM_SIGNAL_HTTP_BASE_URL=https://p2p-signal-staging.fly.dev

GUEST_APP_BASE_URL=https://merm-staging.fly.dev
GUEST_BRIDGE_SECRET=replace_me
STORAGE_DIR=/data/p2p-storage-staging
INTENT_UNLOCK_SECRET=replace_me

OBJECT_STORAGE_BUCKET=merm-staging-signal-storage
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://example-object-endpoint
OBJECT_STORAGE_ACCESS_KEY_ID=replace_me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_me
OBJECT_STORAGE_LABEL=Fly Tigris staging control
OBJECT_STORAGE_PROVIDER_NAME=Fly Tigris
OBJECT_STORAGE_PREFIX=staging-signal
OBJECT_STORAGE_INTENT_PREFIX=staging-signal-intents
OBJECT_STORAGE_FILE_HOLDER_PREFIX=staging-signal-file-holder

# Fly Tigris app-scoped aliases also work:
# BUCKET_NAME, AWS_REGION, AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# Optional staging-only direct-upload benchmark targets.
# Add target ids to OBJECT_STORAGE_BENCH_TARGETS, then provide the matching
# OBJECT_STORAGE_BENCH_<TARGET_ID_UPPERCASE>_* variables below.
#
# Example:
# OBJECT_STORAGE_BENCH_TARGETS=aws_milan,aws_frankfurt,r2_global
#
# Each benchmark target needs:
# OBJECT_STORAGE_BENCH_<ID>_LABEL
# OBJECT_STORAGE_BENCH_<ID>_PROVIDER_NAME
# OBJECT_STORAGE_BENCH_<ID>_REGION
# OBJECT_STORAGE_BENCH_<ID>_ENDPOINT
# OBJECT_STORAGE_BENCH_<ID>_BUCKET
# OBJECT_STORAGE_BENCH_<ID>_ACCESS_KEY_ID
# OBJECT_STORAGE_BENCH_<ID>_SECRET_ACCESS_KEY
# Optional per-target overrides:
# OBJECT_STORAGE_BENCH_<ID>_FORCE_PATH_STYLE
# OBJECT_STORAGE_BENCH_<ID>_PREFIX
# OBJECT_STORAGE_BENCH_<ID>_INTENT_PREFIX
# OBJECT_STORAGE_BENCH_<ID>_FILE_HOLDER_PREFIX
# OBJECT_STORAGE_BENCH_<ID>_UPLOAD_URL_TTL_SEC
# OBJECT_STORAGE_BENCH_<ID>_DOWNLOAD_URL_TTL_SEC

# AWS S3 Milan example
# OBJECT_STORAGE_BENCH_AWS_MILAN_LABEL=AWS S3 Milan benchmark
# OBJECT_STORAGE_BENCH_AWS_MILAN_PROVIDER_NAME=AWS S3
# OBJECT_STORAGE_BENCH_AWS_MILAN_REGION=eu-south-1
# OBJECT_STORAGE_BENCH_AWS_MILAN_ENDPOINT=https://s3.eu-south-1.amazonaws.com
# OBJECT_STORAGE_BENCH_AWS_MILAN_BUCKET=replace_me
# OBJECT_STORAGE_BENCH_AWS_MILAN_ACCESS_KEY_ID=replace_me
# OBJECT_STORAGE_BENCH_AWS_MILAN_SECRET_ACCESS_KEY=replace_me
# OBJECT_STORAGE_BENCH_AWS_MILAN_PREFIX=staging-signal-bench-aws-milan
# OBJECT_STORAGE_BENCH_AWS_MILAN_INTENT_PREFIX=staging-signal-intents
# OBJECT_STORAGE_BENCH_AWS_MILAN_FILE_HOLDER_PREFIX=staging-signal-file-holder

# AWS S3 Frankfurt example
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_LABEL=AWS S3 Frankfurt benchmark
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_PROVIDER_NAME=AWS S3
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_REGION=eu-central-1
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_BUCKET=replace_me
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_ACCESS_KEY_ID=replace_me
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_SECRET_ACCESS_KEY=replace_me
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_PREFIX=staging-signal-bench-aws-frankfurt
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_INTENT_PREFIX=staging-signal-intents
# OBJECT_STORAGE_BENCH_AWS_FRANKFURT_FILE_HOLDER_PREFIX=staging-signal-file-holder

# Cloudflare R2 example
# OBJECT_STORAGE_BENCH_R2_GLOBAL_LABEL=Cloudflare R2 benchmark
# OBJECT_STORAGE_BENCH_R2_GLOBAL_PROVIDER_NAME=Cloudflare R2
# OBJECT_STORAGE_BENCH_R2_GLOBAL_REGION=auto
# OBJECT_STORAGE_BENCH_R2_GLOBAL_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_BENCH_R2_GLOBAL_BUCKET=replace_me
# OBJECT_STORAGE_BENCH_R2_GLOBAL_ACCESS_KEY_ID=replace_me
# OBJECT_STORAGE_BENCH_R2_GLOBAL_SECRET_ACCESS_KEY=replace_me
# OBJECT_STORAGE_BENCH_R2_GLOBAL_PREFIX=staging-signal-bench-r2
# OBJECT_STORAGE_BENCH_R2_GLOBAL_INTENT_PREFIX=staging-signal-intents
# OBJECT_STORAGE_BENCH_R2_GLOBAL_FILE_HOLDER_PREFIX=staging-signal-file-holder
